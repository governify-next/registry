# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=registry
PORT=5900

# Database URIs
MONGO_URI=mongodb://localhost:27017/governify

# Microservices configuration
REPORTER_URL=http://localhost:5901

# JWT configuration
JWT_SECRET=governify_secret_key

# OpenID Connect configuration
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/users/oidc/callback
OIDC_SCOPE=openid email profile

# Application-specific settings
MAX_ROLES_PER_ORGANIZATION = 100;
MAX_MEMBERS_PER_ORGANIZATION = 1000;
